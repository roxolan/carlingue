# carlingue/.gitignore — v0.2 (platform repository; Guichet and Corbeille are separate repos)
# Rule of thumb: ignore what is generated, local, large, or secret.
# Deliberately COMMITTED (do not add here): pnpm-lock.yaml, .terraform.lock.hcl,
# .sops.yaml and *.enc.yaml, Pulumi.demo.yaml (secrets inside are encrypted by Pulumi),
# .changeset/ (including pending changesets), .npmrc (token comes from env),
# small fixtures under */fixtures/, CLAUDE.md / AGENTS.md / .claude/settings.json.

# ---------- Node / pnpm / TypeScript / Turborepo ----------
node_modules/
.pnpm-store/
.turbo/
dist/
build/
*.tsbuildinfo
.eslintcache
coverage/
*.log
npm-debug.log*
pnpm-debug.log*

# ---------- Environment and secrets ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
keys.txt            # age identity for SOPS (encrypted *.enc.yaml files ARE committed)
*.age.key
.terraformrc
terraform.rc
*.credentials.json
.npmrc.local

# ---------- Local runtime data (docker compose volumes, scratch) ----------
.local/
out/
tmp/
docker-volumes/
pgdata/
minio-data/
redpanda-data/
clickhouse-data/
langfuse-data/

# ---------- Eval outputs and sample-tenant scratch ----------
# Domain data generators live in tenant repos; the platform only has eval-runner fixtures.
packages/eval-runner/.cache/
packages/eval-runner/runs/
examples/hello-tenant/.local/
**/*.pdf
!**/fixtures/**/*.pdf

# ---------- Changesets / publishing ----------
# Pending changesets ARE committed; only local release artifacts are not.
.changeset/*.local.*
*.tgz

# ---------- Terraform ----------
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ---------- Pulumi ----------
# Named stack configs (Pulumi.demo.yaml) are committed; ephemeral pr-N configs are generated.
Pulumi.pr-*.yaml
.pulumi/
infra/pulumi/**/bin/
infra/pulumi/**/.automation/

# ---------- Python (services/decision-model, v2) ----------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
# Model weights and adapters are never committed.
services/decision-model/models/
services/decision-model/adapters/
*.safetensors
*.gguf
*.pt
*.ckpt

# ---------- Rust (only if a hot path is ever added) ----------
target/

# ---------- Testing ----------
playwright-report/
test-results/
blob-report/
playwright/.cache/
.nyc_output/

# ---------- Docker ----------
*.tar
.docker/

# ---------- Editors / OS ----------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# ---------- Local AI coding agents ----------
.claude/settings.local.json
.aider*
*.local.md
.agent-scratch/
